# Responsibilities: Public template for a private GPU worker and configured SSH reverse tunnel.
# Implementation: Copy to .env.laptop, fill private values; never commit the populated file.
# Related Modules: start_laptop.py; tools.laptop_config; config.laptop_worker.
# Declaration Index: None.
# Variable Index: DJANGO_SECRET_KEY — private Django secret; LAPTOP_INFERENCE_TOKEN — cloud token;
# LAPTOP_SSH_HOST/USER/PORT/KEY_PATH/KNOWN_HOSTS — explicit SSH endpoint/authentication/trust;
# LAPTOP_WORKER_PORT/REMOTE_PORT — loopback ports; LAPTOP_GPU_INDEX — optional physical device;
# LAPTOP_ONNX_PATH/SERVER_ONNX_PATH — pinned artifact locations; LAPTOP_PUBLIC_URL — HTTPS probe.
DJANGO_SECRET_KEY=
LAPTOP_INFERENCE_TOKEN=
LAPTOP_SSH_HOST=
LAPTOP_SSH_USER=
LAPTOP_SSH_PORT=22
LAPTOP_SSH_KEY_PATH=
LAPTOP_SSH_KNOWN_HOSTS=~/.ssh/known_hosts
LAPTOP_WORKER_PORT=18767
LAPTOP_REMOTE_PORT=18767
# Empty selects the first compatible NVIDIA GPU; override with --gpu-index.
LAPTOP_GPU_INDEX=
LAPTOP_ONNX_PATH=models/yolo26n.onnx
# Optional: retrieve missing ONNX from this explicit cloud file via SFTP; SHA256 must match.
LAPTOP_SERVER_ONNX_PATH=
# Optional HTTPS page URL with its project prefix, e.g. https://your-domain/prs/.
LAPTOP_PUBLIC_URL=
