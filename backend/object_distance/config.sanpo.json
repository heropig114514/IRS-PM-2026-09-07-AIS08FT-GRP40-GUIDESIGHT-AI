{
  "detection_weights": "models/yolo26n.pt",
  "processed": "model_tests/datasets/sanpo/processed-person-manual",
  "freeze_backbone": true,
  "unfreeze_last_layers": 0,
  "learning_rate": 0.001,
  "batch_size": 8,
  "epochs": 10,
  "image_size": 640,
  "device": "cuda:0",
  "seed": 42,
  "amp": true,
  "workers": 0,
  "roi_size": 3,
  "hidden_dim": 128,
  "initial_distance_m": 5,
  "confidence": 0.25,
  "match_iou": 0.5,
  "supported_classes": [
    "car",
    "person"
  ],
  "distance_bins_m": [
    0,
    2,
    5,
    10,
    20,
    40,
    80
  ],
  "cpu_threads": 1,
  "distance_target": "sanpo_visible_surface_median_m"
}
