# Responsibilities: 独立摄像头/HF/MCP服务，仅监听 127.0.0.1:8766。
# Implementation: 单worker、启用MCP lifespan、5条传输层输入队列、明确资源预算、无自动重启；运行目录可写，源码只读。
# Related Modules: config.camera_server, core.hf_video_relay/ai_mcp/ai_bridge, nginx.locations.conf。
# Declaration Index: None。
# Variable Index: User/Group 为 prs-camera；EnvironmentFile 为专用凭据；
# MemoryMax/CPUQuota/TasksMax 为独立服务预算；ExecStart 为固定 ASGI 运行参数。
# OPENBLAS_NUM_THREADS 限制数值库线程，限制共享数值库，避免争用其他应用。
# WS上限1310728包含1MiB JPEG、256KiB融合/跟踪元数据及8字节头；输入队列仍为5。
[Unit]
Description=PRS camera echo and YOLO26 service
After=network.target

[Service]
Type=simple
User=prs-camera
Group=prs-camera
WorkingDirectory=/opt/prs-practice/current/backend
EnvironmentFile=/etc/prs-camera/app.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=OPENBLAS_NUM_THREADS=1
ExecStart=/opt/prs-practice/runtime-venv/bin/python -m uvicorn config.asgi:application --host 127.0.0.1 --port 8766 --workers 1 --lifespan on --ws websockets-sansio --ws-max-size 1310728 --ws-max-queue 5 --ws-per-message-deflate false --no-proxy-headers
Restart=no
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=prs-practice
StateDirectoryMode=0700
ReadWritePaths=/var/lib/prs-practice
MemoryMax=256M
CPUQuota=20%
TasksMax=32
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
