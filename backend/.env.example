# Responsibilities: 本地开发配置模板；复制为 .env 后设置自己的密钥。
# Implementation: config.base 读取此文件，已有进程环境变量优先。
# Related Modules: config/base.py, config/settings.py, config/production.py, core/services.py/core.detector。
# Declaration Index: None。
# Variable Index: DJANGO_SECRET_KEY 为必填独立随机密钥；ORS_API_KEY 为可选后端路线凭据。
# YOLO_MODEL_PATH — 可选检测模式的固定 ONNX 文件绝对路径，必须匹配模型清单。
# DJANGO_ALLOWED_HOSTS — 生产 Host 白名单；POSTGRES_DB/USER/PASSWORD/HOST/PORT — 生产数据库参数。
# 使用 python -c "import secrets; print(secrets.token_urlsafe(48))" 生成后填入。
DJANGO_SECRET_KEY=

# ORS 标准 API key，仅后端读取；缺失时路线请求明确失败，浏览器仍可显示位置与 OSM。
ORS_API_KEY=

# 检测模式须安装 requirements-vision.txt 并先导出模型；缺失时检测明确返回 503。
YOLO_MODEL_PATH=

# 生产必须显式使用 config.production，并配置下列全部变量。
# DJANGO_ALLOWED_HOSTS=example.com
# POSTGRES_DB=prs
# POSTGRES_USER=prs
# POSTGRES_PASSWORD=
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
