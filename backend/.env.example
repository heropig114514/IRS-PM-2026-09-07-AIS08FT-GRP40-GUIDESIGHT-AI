# Responsibilities: 本地开发配置模板；复制为 .env 后设置自己的密钥。
# Implementation: config.base 读取复制后的 .env，已有进程环境变量优先。
# Related Modules: config/base.py, config/settings.py, config/production.py, core/services.py/core.hf_video_relay。
# Declaration Index: None。
# Variable Index: DJANGO_SECRET_KEY 为必填独立随机密钥；ORS_API_KEY 为可选后端路线凭据；
# DASHSCOPE_API_KEY/DASHSCOPE_HOST/VLM_MODEL 为场景描述（Qwen 视觉模型）的后端配置。
# HF_INFERENCE_TOKEN — ZeroGPU 视频必须的私有身份凭据，只由后端使用；空值拒绝申请。
# DJANGO_ALLOWED_HOSTS — 生产 Host 白名单；POSTGRES_DB/USER/PASSWORD/HOST/PORT — 生产数据库参数。
# 使用 python -c "import secrets; print(secrets.token_urlsafe(48))" 生成后填入。
DJANGO_SECRET_KEY=

# ORS 标准 API key，仅后端读取；缺失时路线请求明确失败，浏览器仍可显示位置与 OSM。
ORS_API_KEY=

# 场景描述（POST /scene/describe/）使用的阿里云 DashScope 密钥，仅后端读取；缺失时接口返回 503。
DASHSCOPE_API_KEY=
# DashScope 主机名（仅主机名，不含协议/端口/路径）。默认国际站 dashscope-intl.aliyuncs.com，
# 适用于阿里云香港服务器；中国大陆站为 dashscope.aliyuncs.com，需使用对应站点的 key。
# DASHSCOPE_HOST=dashscope-intl.aliyuncs.com
# 视觉模型名；默认 qwen3.7-flash（国际站无 qwen2.5-vl-7b-instruct）。
# VLM_MODEL=qwen3.7-flash


# 仅显式 ZeroGPU 模式读取；浏览器登录不会给服务器 API 提供身份。
HF_INFERENCE_TOKEN=

# 生产必须显式使用 config.production，并配置下列全部变量。
# DJANGO_ALLOWED_HOSTS=example.com
# POSTGRES_DB=prs
# POSTGRES_USER=prs
# POSTGRES_PASSWORD=
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
