  "conclusion": "For every >500ms steady frame, at least 98.15% of its observed queue wait overlaps prior host pipeline intervals even under the allowed dequeue-offset uncertainty. The queue mainly waits for serial preceding frame processing; this is not a measurement of pure GPU occupancy.",
  "method": {
    "worker_start": "S_i = (tracking_timestamp_s_i - first_session_tracking_timestamp_s) * 1000",
    "pipeline_end": "E_i = S_i + pipeline_server_ms (Graph wrapper), otherwise S_i + server_ms",
    "unknown_offset": "d_i = S_i - D_i, with D_i the recorded queue-end timing point. Single FIFO writer gives 0 <= d_i <= S_i - E_(i-1) = G_i.",
    "queue_window": "[S_i - d_i - Q_i, S_i - d_i], Q_i = resident_queue_ms",
    "extrema": "Intersect each candidate window with all prior original-pipeline intervals; evaluate both offset endpoints and all start/end alignment breakpoints of this piecewise-linear sum.",
    "certain_full_frames": "Only prior intervals with start >= S_i-Q_i and end <= S_i-G_i receive complete exclusive-stage attribution; no proportional allocation for partial boundary intervals.",
    "cold": "First frame retained but no predecessor-offset reconstruction; excluded from steady distributions.",
    "exclusive_stages": [
      "prepare_ms",
      "gpu_stage_ms",
      "decode_boxes_ms",
      "tracking_ms",
