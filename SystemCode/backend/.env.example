# Responsibilities: Template for local configuration; copy to .env and supply private credentials.
# Implementation: config.base loads .env; existing process environment variables take precedence.
# Related Modules: config/base.py, config/settings.py, config/production.py, core/services.py,
# core.hf_video_relay and core/agent.
# Declaration Index: None.
# Variable Index: DJANGO_SECRET_KEY — required independent random secret; ORS_API_KEY — route credential;
# DASHSCOPE_API_KEY/DASHSCOPE_HOST/VLM_MODEL — Qwen scene-description configuration;
# PRS_AGENT_API_KEY/PRS_AGENT_BASE_URL/PRS_AGENT_MODEL — agent credential/region/model;
# PRS_AGENT_MAX_CONTEXT_CHARS — compact JSON character budget (60,000..180,000; default 150,000);
# PRS_ASR_MODEL — short-recording recognition model; PRS_AGENT_SEARCH_COUNTRY/PRS_AGENT_SEARCH_LANGUAGE
# — default place-search country/language, separate from device location and UI language;
# HF_INFERENCE_TOKEN — private server-only ZeroGPU identity, required before allocation;
# DJANGO_ALLOWED_HOSTS — production Host allowlist; POSTGRES_DB/USER/PASSWORD/HOST/PORT — database settings.
# Generate with python -c "import secrets; print(secrets.token_urlsafe(48))" and fill in the value.
DJANGO_SECRET_KEY=

# Standard ORS API key, server-only. Missing credentials fail routes explicitly; location/OSM remain available.
ORS_API_KEY=

# Independent server-side voice/text agent settings; existing VLM/camera parameters remain unchanged.
# Match the explicit region to the key; provider calls retry one transient transport/HTTP failure,
# while MCP/browser/device actions are never replayed. Up to 8 turns and 180s per task.
PRS_AGENT_API_KEY=
PRS_AGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
PRS_AGENT_MODEL=qwen3.6-plus
PRS_AGENT_MAX_CONTEXT_CHARS=150000
PRS_ASR_MODEL=qwen3-asr-flash
# Default destination search scope (three-letter ISO country code), not user location; explicit overseas requests may override it.
PRS_AGENT_SEARCH_COUNTRY=SGP
# Query language for names in the default search region; not the voice/UI language.
PRS_AGENT_SEARCH_LANGUAGE=en

# Server-only DashScope key for POST /scene/describe/; the endpoint returns 503 when missing.
DASHSCOPE_API_KEY=
# DashScope hostname only, without scheme/port/path. Default: international dashscope-intl.aliyuncs.com
# for the Hong Kong deployment; mainland China uses dashscope.aliyuncs.com with a matching regional key.
# DASHSCOPE_HOST=dashscope-intl.aliyuncs.com
# Vision model: qwen3-vl-plus by default; qwen3.7-flash is an explicitly configurable lower-cost option.
# The international endpoint does not provide qwen2.5-vl.
# VLM_MODEL=qwen3-vl-plus


# Read only in explicit ZeroGPU mode; browser login does not authenticate the server API.
HF_INFERENCE_TOKEN=

# Production must explicitly select config.production and configure all fields below.
# DJANGO_ALLOWED_HOSTS=example.com
# POSTGRES_DB=prs
# POSTGRES_USER=prs
# POSTGRES_PASSWORD=
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
