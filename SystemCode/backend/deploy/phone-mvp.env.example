# Responsibilities: Select the optimized server-Web plus local-GPU phone comparison.
# Implementation: Merge only these nonsecret settings into the existing server app.env.
# Related Modules: integration.mobile_asgi; tools.run_phone_mvp; SERVER-RELAY.md.
# Declaration Index: None.
# Variable Index: loopback URLs bind the server Web and separately owned reverse GPU tunnel;
# capture/display/voice settings match the accepted phone MVP without changing model policy.
# Preserve existing Django, database, ORS and optional provider keys. Do not replace app.env.
LOCAL_WEB_ORIGIN=http://127.0.0.1:18766
LOCAL_INFERENCE_URL=ws://127.0.0.1:18767/ws/infer/
LOCAL_MVP_MODE=assist
MOBILE_PUBLIC_ORIGIN=https://47.239.50.129
PRS_CAMERA_PROFILE=low-latency-2
PRS_LATENCY_PANEL=1
PRS_PREPARED_SPEECH=1
PRS_RISK_TTL_MS=2000
# Empty selects the existing local TTS provider for wording outside the prepared pack.
PRS_TTS_UPSTREAM_ORIGIN=
