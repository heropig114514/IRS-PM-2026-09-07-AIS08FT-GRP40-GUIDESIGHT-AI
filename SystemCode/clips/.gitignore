# Responsibilities: Track implementation source and selected test videos; keep credentials, environments, course deliverables, and generated artifacts local.
# Implementation: Use an allowlist at the SystemCode/clips source root and ignore private/runtime assets, generated outputs, and unselected model data.
# Related Modules: backend/tools/deploy_space.py, backend/tools/prepare_kaggle.py,
# backend/model_tests/README.md, README.md.
# Declaration Index: None.
# Variable Index: None.
/*
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/README.md
!/backend/
!/frontend/

**/__pycache__/
*.py[cod]
.venv/
.venv-inference/
.venv-evaluation/
.venv-space/
backend/.space-bundle/
backend/.kaggle-bundle/
.env
.env.*
backend/server_info.txt
!.env.example
*.sqlite3
*.sqlite3-*
*.log
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
node_modules/
dist/
media/
staticfiles/
test-results/
backend/model_tests/datasets/*
!backend/model_tests/datasets/README.md
!backend/model_tests/datasets/street-video/
backend/model_tests/datasets/street-video/**
!backend/model_tests/datasets/street-video/SOURCES.json
!backend/model_tests/datasets/street-video/mot17/
!backend/model_tests/datasets/street-video/mot17/MOT17-07-FRCNN-raw.mp4
!backend/model_tests/datasets/street-video/mot17/MOT17-07-FRCNN-browser-h264.mp4
!backend/model_tests/datasets/street-video/mot17/MOT17-10-FRCNN-raw.mp4
!backend/model_tests/datasets/street-video/mot17/MOT17-10-FRCNN-browser-h264.mp4
backend/model_tests/outputs/*
!backend/model_tests/outputs/README.md
backend/models/*.pt
backend/models/*.onnx
backend/models/*.onnx.data
backend/models/.build-config/
backend/models/experiments/
backend/models/*.tmp
